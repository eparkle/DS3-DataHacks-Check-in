VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional. The app checks people into the event picked in the header (from the
# organizer's event_roles). This id is only used if that list can't be loaded.
VITE_EVENT_ID=

# Desk scripts (generate_checkin_codes.py, send_emails.py) need the service role
# so they can read v_checkin_list. Never expose this key in the Vite app or Vercel.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
EVENT_ID=

WALLETWALLET_API_KEY=
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
SEND_DELAY_SECONDS=1
